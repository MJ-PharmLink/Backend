    {
      "name": "3. 정상 케이스",
      "item": [
        {
          "name": "9.1 납품 목록 (status=WAITING, 고객사 필터) → 200",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/deliveries?status=WAITING&partner_id={{customer_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "deliveries"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "WAITING"
                },
                {
                  "key": "partner_id",
                  "value": "{{customer_id}}"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{sales_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data;",
                  "pm.test(\"모두 WAITING·해당 고객사\", () => rows.forEach(r => { pm.expect(r.status).to.eql(\"WAITING\"); pm.expect(r.partner_id).to.eql(Number(pm.collectionVariables.get(\"customer_id\"))); }));",
                  "pm.test(\"납품 A 포함, 주문번호·총액 포함\", () => { const a = rows.find(r => r.delivery_id === Number(pm.collectionVariables.get(\"delivery_a\"))); pm.expect(a).to.not.be.undefined; pm.expect(a.order_number).to.match(/^ORD-/); pm.expect(a.total_amount).to.eql(Number(pm.collectionVariables.get(\"order_a_amount\"))); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9.2 납품 상세 → 200 (품목, 원가 없음, 일시 null)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/deliveries/{{delivery_a}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "deliveries",
                "{{delivery_a}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{warehouse_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"품목 1건, unit_cost 없음\", () => { pm.expect(d.items).to.have.length(1); pm.expect(d.items[0]).to.not.have.property(\"unit_cost\"); });",
                  "pm.test(\"shipped_at·delivered_at null\", () => { pm.expect(d.shipped_at).to.eql(null); pm.expect(d.delivered_at).to.eql(null); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9.3 출고 완료 (창고) → 200 SHIPPED",
          "request": {
            "method": "POST",
            "header": [
              {
