                  "const d = pm.response.json().data;",
                  "pm.test(\"status SHIPPED, shipped_at(UTC)\", () => { pm.expect(d.status).to.eql(\"SHIPPED\"); pm.expect(d.shipped_at).to.match(/Z$/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "9.4 납품 완료 (창고) → 200 DELIVERED + 매출",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
