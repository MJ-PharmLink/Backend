    {
      "name": "2. 회사 정보 조회 (13.1)",
      "item": [
        {
          "name": "관리자 조회 → 200 (원래 값 저장)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/company",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "company"
              ]
            },
            "description": "테스트가 끝나면 이 요청에서 저장한 원래 값으로 회사 정보를 되돌립니다."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"응답 필드 (snake_case)\", () => pm.expect(body.data).to.have.keys(\"company_id\",\"name\",\"business_number\",\"representative_name\",\"wholesale_license_number\",\"address\",\"phone\",\"fax\",\"email\",\"updated_at\"));",
                  "pm.test(\"company_id = 1\", () => pm.expect(body.data.company_id).to.eql(1));",
                  "pm.test(\"updated_at은 UTC(Z)\", () => pm.expect(body.data.updated_at).to.match(/Z$/));",
                  "// 마지막 \"원래 값으로 되돌리기\"에서 쓰려고 지금 값을 저장해 둔다",
                  "const { company_id, updated_at, ...original } = body.data;",
                  "pm.collectionVariables.set(\"company_original\", JSON.stringify(original));"
                ]
              }
            }
          ]
        },
        {
          "name": "영업 계정 조회 → 200",
          "request": {
            "method": "GET",
            "header": [],
